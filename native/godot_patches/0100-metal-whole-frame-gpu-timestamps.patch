+
+void RenderingDeviceDriverMetal::_timestamp_command_buffer_completed(void *p_pool, MTL::CommandBuffer *p_command_buffer) {
+	TimestampQueryPool *pool = (TimestampQueryPool *)p_pool;
+	const double start_seconds = p_command_buffer->GPUStartTime();
+	const double end_seconds = p_command_buffer->GPUEndTime();
+	if (start_seconds <= 0.0 || end_seconds < start_seconds) {
+		return;
+	}
+
+	const uint64_t start_ns = (uint64_t)(start_seconds * 1000000000.0);
+	const uint64_t end_ns = (uint64_t)(end_seconds * 1000000000.0);
+	MutexLock lock(pool->mutex);
+	if (pool->gpu_start_ns == 0 || start_ns < pool->gpu_start_ns) {
+		pool->gpu_start_ns = start_ns;
+	}
+	if (end_ns > pool->gpu_end_ns) {
+		pool->gpu_end_ns = end_ns;
+	}
 }
 
