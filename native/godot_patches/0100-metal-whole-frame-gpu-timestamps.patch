+	TimestampQueryPool *pool = (TimestampQueryPool *)p_pool_id.id;
+	MutexLock lock(pool->mutex);
+	DEV_ASSERT(p_query_count <= pool->query_count);
+	for (uint32_t i = 0; i < p_query_count; i++) {
+		// Metal exposes whole-command-buffer times even when counter sampling is
+		// unavailable. Keep intermediate markers at the start so no fabricated
+		// per-pass timings are reported, while the final delta is the real total.
+		r_results[i] = i + 1 == p_query_count ? pool->gpu_end_ns : pool->gpu_start_ns;
