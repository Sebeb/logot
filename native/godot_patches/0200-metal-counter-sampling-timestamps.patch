+
+void RenderingDeviceDriverMetal::_initialize_timestamp_counters() {
+	if (!device->supportsCounterSampling(MTL::CounterSamplingPointAtStageBoundary)) {
+		return;
+	}
+
+	NS::Array *counter_sets = device->counterSets();
+	for (NS::UInteger i = 0; i < counter_sets->count(); i++) {
+		MTL::CounterSet *counter_set = counter_sets->object<MTL::CounterSet>(i);
+		if (counter_set->name()->isEqualToString(MTL::CommonCounterSetTimestamp)) {
+			timestamp_counter_set = NS::RetainPtr(counter_set);
+			break;
+		}
+	}
+	if (!timestamp_counter_set) {
+		return;
+	}
+
+	mach_timebase_info_data_t timebase;
+	if (mach_timebase_info(&timebase) == KERN_SUCCESS && timebase.denom != 0) {
+		timestamp_ns_per_cpu_tick = (double)timebase.numer / (double)timebase.denom;
+	}
+	device->sampleTimestamps(&timestamp_cpu_reference, &timestamp_gpu_reference);
+	print_verbose("Metal GPU timestamp counter sampling enabled.");
+}
+
+void RenderingDeviceDriverMetal::_refresh_timestamp_period() {
+	MTL::Timestamp cpu_now = 0;
+	MTL::Timestamp gpu_now = 0;
+	device->sampleTimestamps(&cpu_now, &gpu_now);
+	if (cpu_now > timestamp_cpu_reference && gpu_now > timestamp_gpu_reference) {
+		timestamp_ns_per_gpu_tick = ((double)(cpu_now - timestamp_cpu_reference) * timestamp_ns_per_cpu_tick) / (double)(gpu_now - timestamp_gpu_reference);
+		timestamp_cpu_reference = cpu_now;
+		timestamp_gpu_reference = gpu_now;
+	}
 }
 
