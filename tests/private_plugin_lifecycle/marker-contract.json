      "required": [
        "schema",
        "collection",
        "scenario",
        "sources_completed",
        "classes_updated",
        "filesystem_changed",
        "scanning",
        "importing",
        "deadline_unix_ms"
      ],
      "properties": {
        "schema": {
          "type": "integer",
          "const": 1
        },
        "collection": {
          "type": "string",
          "const": "lifecycle"
        },
