{
  "schema_version": 1,
  "encoding": "one exact prefix then one JSON object per line",
  "ready": {
    "prefix": "LIFECYCLE READY ",
    "count_per_driven_process": 1,
    "fields": {
      "schema": "integer exactly1",
      "collection": "string exactly lifecycle",
      "scenario": "string main or preexisting",
      "sources_completed": "boolean true",
      "classes_updated": "boolean true",
      "filesystem_changed": "boolean true",
      "scanning": "boolean false",
      "importing": "boolean false",
      "deadline_unix_ms": "integer exactly admitted fixed editor deadline"
    }
  },
  "witness": {
    "prefix": "LIFECYCLE WITNESS ",
    "fields": {
      "schema": "integer exactly1",
      "collection": "string exactly lifecycle",
      "ordinal": "integer contiguous1..24 or1..6",
      "passed": "boolean exact expected outcome for label",
      "label": "string exact ordered main/preexisting label",
      "exists": "boolean",
      "raw": "string",
      "resolved": "string",
      "known": "boolean",
      "singleton": "boolean"
    }
  },
  "identity_collection": {
    "prefix": "LIFECYCLE IDENTITY COLLECTION ",
    "fields": {
      "schema": "integer exactly1",
      "collection": "string exactly identity",
      "labels": "array of exact ordered strings",
      "expected_checks": "integer exactly1 baseline or8 candidate"
    }
  },
  "identity_check": {
    "prefix": "LIFECYCLE IDENTITY CHECK ",
    "fields": {
      "schema": "integer exactly1",
      "collection": "string exactly identity",
      "ordinal": "integer contiguous1..1 baseline or1..8 candidate",
      "label": "string exact identity label",
      "passed": "boolean false for baseline capability_absent; true for all candidate checks"
    }
  },
  "identity_result": {
    "prefix": "LIFECYCLE IDENTITY RESULT ",
    "fields": {
      "schema": "integer exactly1",
      "collection": "string exactly identity",
      "checks": "integer exactly1 baseline or8 candidate",
      "failures": "integer exactly1 baseline or0 candidate",
      "failed_labels": "array exactly[identity.capability_absent] baseline or[] candidate",
      "precondition_error": "string empty"
    }
  },
  "identity_labels": {
    "base": [
      "identity.capability_absent"
    ],
    "candidate": [
      "identity.singleton_path",
      "identity.singleton_uid",
      "identity.path",
      "identity.foreign_path",
      "identity.unknown_uid",
      "identity.unknown_unclaimed",
      "identity.unknown_preserved",
      "identity.unknown_released"
    ]
  },
  "ordered_boundary": "READY; PANEL COLLECTION; PANEL CHECK1..3; PANEL RESULT; lifecycle checks1..4; IDENTITY COLLECTION/CHECK/RESULT; lifecycle checks5..24; main RESULT. Preexisting READY; PANEL collection/checks/result; lifecycle checks1..6; main RESULT, no identity. Independent ordinals per collection.",
  "main_result_prefix": "LIFECYCLE RESULT checks=",
  "process_exit": "Any unexpected panel failure or precondition error forces exit1 independently of main24+6 and identity. Candidate all clean required. Current baseline foreign behavior is a demonstrated production defect and is not waived; root separately dispositions retained baseline evidence without automatic rerun.",
  "json_schemas": {
    "ready": {
